# --- Discord ---
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
# Optional: register commands to a single guild (instant). Leave blank for global (up to 1h propagation).
DISCORD_DEV_GUILD_ID=

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- AI Provider (OpenAI-compatible) ---
# Defaults are set for Groq free tier. Swap base URL / model to use OpenAI, Together, OpenRouter, etc.
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
# Optional but recommended for OpenRouter attribution/routing
AI_HTTP_REFERER=https://github.com/AnubhavSingh0603/chatscribe
AI_APP_TITLE=ChatScribe

# --- Tunables (optional) ---
SUMMARY_TRIGGER_COUNT=300
MAX_MESSAGES_PER_CHANNEL=1000
MESSAGE_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
FACTCHECK_COOLDOWN_SECONDS=10
MESSAGE_STORE_CHAR_LIMIT=1200
SUMMARY_RETENTION_DAYS=90
